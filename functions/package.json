{
  "name": "@theloop/functions",
  "version": "0.1.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/policy.test.ts test/service.test.ts test/notifications.test.ts test/cleanup.test.ts test/contributions.test.ts test/authorControls.test.ts test/directory.test.ts test/squads.test.ts",
    "test:rules": "tsx --test test/rules.test.ts",
    "seed:emulator": "tsx scripts/seed-emulator.ts",
    "seed:live": "tsx scripts/seed-live.ts"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0"
  }
}
