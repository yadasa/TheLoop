EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Optional web deployment for shared links, e.g. https://your-web-domain.example
EXPO_PUBLIC_WEB_URL=
EXPO_PUBLIC_EMULATOR_HOST=
# Emulator mode requires a demo-* project and local/LAN host. Defaults:9099/8080/5001.
# Leave all emulator variables empty in live mode.
EXPO_PUBLIC_AUTH_EMULATOR_PORT=
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=
EXPO_PUBLIC_FUNCTIONS_EMULATOR_PORT=
# Live Android EAS build: public google-services.json as a local path or EAS file variable.
# Sample and emulator modes ignore this. Never supply a service-account private key.
THELOOP_GOOGLE_SERVICES_FILE=
# Explicit opt-in only. Default/sample ignores Firebase identifiers below.
THELOOP_NATIVE_MODE=sample
# Live requires all six public identifiers from the dedicated TheLoop SDK config.
