{
  "name": "@theloop/mobile",
  "version": "0.4.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:stable": "node scripts/start-stable.cjs",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test ../../scripts/chat-presentation.test.ts ../../scripts/conference-presentation.test.ts ../../scripts/dialog-queue.test.ts ../../scripts/conversation-drafts.test.ts ../../scripts/image-drafts.test.ts ../../scripts/event-presentation.test.ts ../../scripts/search-destinations.test.ts ../../scripts/profile-form.test.ts ../../scripts/notification-presentation.test.ts ../../scripts/shared-links.test.ts ../../scripts/media-visibility.test.ts ../../scripts/direct-inbox-presentation.test.ts ../../scripts/profile-code.test.ts ../../scripts/post-drafts.test.ts ../../scripts/connection-state.test.ts ../../scripts/draft-changes.test.ts",
    "test:config": "node ../../scripts/native-config.test.cjs && tsx --test ../../scripts/native-runtime.test.ts",
    "start:live:check": "node ../../scripts/start-native-live.mjs --public-firebase-config ../../.cache/firebase.public-sdk.json --check",
    "start:live": "node ../../scripts/start-native-live.mjs --public-firebase-config ../../.cache/firebase.public-sdk.json --start",
    "export:native": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@theloop/client": "workspace:*",
    "@theloop/core": "workspace:*",
    "expo": "~58.0.19",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^12.17.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "jsqr": "1.4.0",
    "typescript": "~6.0.3"
  }
}
