{
  "name": "@theloop/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:native": "expo export --platform ios --platform android --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@theloop/core": "workspace:*",
    "@theloop/client": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-dev-client": "~58.0.15",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.11",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-calendar": "~58.0.6",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
