{
  "expo": {
    "name": "TheLoop",
    "slug": "theloop-community",
    "version": "0.2.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "scheme": "theloop",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "2",
      "supportsTablet": true,
      "bundleIdentifier": "co.theloop.community",
      "infoPlist": {
        "NSCalendarsUsageDescription": "Save events you choose to your calendar.",
        "NSCalendarsFullAccessUsageDescription": "Save events you choose to your calendar.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Save events you choose to your calendar."
      }
    },
    "android": {
      "versionCode": 2,
      "package": "co.theloop.community",
      "adaptiveIcon": {
        "backgroundColor": "#171816",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "TheLoop",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose an image to share with your people.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#171816",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Save events you choose to your calendar."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "32f68c1f-9301-43d0-886b-93bbc35ea208"
      }
    },
    "owner": "keithazodeh"
  }
}
