{
  "name": "theloop", "version": "0.1.0", "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @theloop/web dev",
    "mobile": "pnpm --filter @theloop/mobile start",
    "build": "pnpm --filter @theloop/web build && pnpm --filter @theloop/functions build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @theloop/core test && pnpm --filter @theloop/client test && pnpm --filter @theloop/web test && pnpm --filter @theloop/functions test",
    "emulators": "firebase emulators:start --project demo-theloop",
    "test:rules": "firebase emulators:exec --project demo-theloop --only firestore,auth \"pnpm --filter @theloop/functions test:rules\""
  },
  "devDependencies": { "typescript": "^5.9.3", "tsx": "^4.20.6", "@types/node": "^22.0.0" }
}
